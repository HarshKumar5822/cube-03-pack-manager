# Copy to backend/.env and fill in ONE provider. Never commit .env.
# Leave both blank and the app still runs: every box is held for manual check and nothing is guessed.

# Groq (default, free tier available). Vision models as of Sept 2026; run "Check models" on the System page to confirm.
GROQ_API_KEY=

GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Anthropic Claude (also sends catalogue reference photos to the model, which helps with look-alike products)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# auto = Anthropic if its key is set, otherwise Groq. Or force: groq | anthropic
VISION_PROVIDER=auto

# Decision tuning
CONFIDENCE_THRESHOLD=0.62
# Used only for the "estimated cost avoided" KPI. It is an assumption, not a measurement.
COST_PER_WRONG_SHIPMENT=35

# Failure drill: set to true to prove the app holds boxes (PENDING_REVIEW) when the AI is down.
FORCE_VISION_FAILURE=false

PORT=4000
